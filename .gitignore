# Local environment — contains real phone number and extension password
.env

# SignalWire credentials — auto-provisioned, contains SIP username/password
configs/storage/signalwire-conf.dat

# SignalWire provisioning secrets
configs/storage/adoption-auth.dat
configs/storage/adoption-token.dat

# Per-extension SIP passwords (see extension-passwords.txt)
configs/storage/extension-passwords.txt

# ESL (Event Socket) admin password
configs/storage/esl-password.txt

# Generated from vars.local.xml.template by entrypoint.sh at container start — never edit,
# never commit. The tracked .template file has placeholder tokens only.
configs/freeswitch/vars.local.xml

# Generated from configs/storage/extension-passwords.txt by entrypoint.sh at container start.
configs/freeswitch/ext-passwords.local.xml

# TLS/DTLS-SRTP/WSS private keys, auto-generated by FreeSWITCH on first start (self-signed).
# Unencrypted private keys — never commit even though they're self-signed.
configs/freeswitch/tls/

# FreeSwitch logs
logs/

# Vim swap files
*.swp
*.swo
