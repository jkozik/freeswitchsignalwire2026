# Your SignalWire DID in E.164 format
MYSIGNALWIREPHONENUMBERWITHPLUS=+1NPANXXXXXX

# Your mobile number in E.164 format — used by the restricted dialplan context
# (configs/freeswitch/dialplan/restricted.xml) so spare/test extensions can only
# call this number, your SignalWire DID, and other internal extensions.
MYMOBILEPHONENUMBERWITHPLUS=+1NPANXXXXXX

# Event Socket (ESL, port 8021) admin password. Only reachable from inside the
# container/VM (apply-inbound-acl=loopback.auto) — see README.md Verification Tests.
ESLPASSWORD=changeme

# RTP port range — keep the window small for home/small office use
RTPSTARTPORT=20000
RTPENDPORT=20100

# Per-extension SIP passwords are NOT set via .env — see configs/storage/extension-passwords.txt
# and README.md "Restricted extensions".
FREESWITCHDEFAULTPASSWORD=changeme
